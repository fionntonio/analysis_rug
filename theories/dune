; Waterproof is installed in user-contrib and found automatically by coqc.
; We load its OCaml plugin explicitly to enable Waterproof vernacular commands.

(rocq.theory
 (name RUG.Analysis)
 (package waterproof-analysis)
 (synopsis "Undergraduate real analysis formalized in Waterproof")
 (theories Stdlib Ltac2 Waterproof)
 (plugins
  rocq-waterproof.plugin
  rocq-runtime.plugins.ltac
  rocq-runtime.plugins.ltac2)
 (rocqdoc_flags :standard --utf8))

(include_subdirs qualified)
